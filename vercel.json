{
  "version": 2,
  "routes": [
    {"handle": "filesystem"},
    {"src": "/js/libs/(.*)", "dest": "https://neoul-sok-ai.vercel.app/js/libs/$1"},
    {"src": "/js/plugins/(.*)", "dest": "https://neoul-sok-ai.vercel.app/js/plugins/$1"},
    {"src": "/js/(rpg_.*\\.js)", "dest": "https://neoul-sok-ai.vercel.app/js/$1"},
    {"src": "/fonts/(.*)", "dest": "https://neoul-sok-ai.vercel.app/fonts/$1"},
    {"src": "/icon/(.*)", "dest": "https://neoul-sok-ai.vercel.app/icon/$1"},
    {"src": "/img/(animations|battlebacks1|battlebacks2|characters|enemies|faces|parallaxes|pictures|sv_actors|sv_enemies|system|tilesets)/(.*)", "dest": "https://neoul-sok-ai.vercel.app/img/$1/$2"},
    {"src": "/audio/(bgm|bgs|me|se)/(.*)", "dest": "https://neoul-sok-ai.vercel.app/audio/$1/$2"},
    {"src": "/data/(.*)", "dest": "https://neoul-sok-ai.vercel.app/data/$1"}
  ]
}
